# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_API_KEY=

# Backend
SERVER_HOST=localhost
SERVER_PORT=3001

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# App
APP_ENV=development
LOG_LEVEL=debug

# ===== Phase 2: MCP Tool Server =====

# fastmcp
MCP_SERVER_NAME=crypto-predictor
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=4000

# Model
MODEL_DIR=./models
PRICE_ONLY_MODEL_NAME=price_only_lgbm.pkl

# Data (Phase 2 uses mock data)
PRICE_DATA_SOURCE=mock

# ===== Phase 3: MCP Client (Backend -> Tool Server) =====

# fastmcp client
MCP_CLIENT_HOST=http://localhost:4000
MCP_CLIENT_TIMEOUT_MS=30000

# ===== Phase 4: News Analysis & Price+Text Model =====

# News analysis
NEWS_MODEL_TYPE=finbert
NEWS_MAX_LENGTH=2000

# Model (price + text)
PRICE_TEXT_MODEL_NAME=price_text_lgbm.pkl
