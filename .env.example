# =============================================
# MCP Orchestrator - 環境配置範例
# =============================================
# 複製此文件為 .env 並填入實際值

# ===== Next.js 服務 =====
NEXT_HOST=0.0.0.0
NEXT_PORT=3000

# ===== Next.js API Routes =====
# Ollama 服務
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_API_KEY=

# MCP Client (Next.js -> MCP Server)
MCP_CLIENT_HOST=http://127.0.0.1:4000
MCP_CLIENT_TIMEOUT_MS=30000

# ===== MCP Tool Server (Python) =====
MCP_SERVER_NAME=crypto-predictor
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=4000

# Model
MODEL_DIR=./models
PRICE_ONLY_MODEL_NAME=price_only_lgbm.pkl
PRICE_TEXT_MODEL_NAME=price_text_lgbm.pkl

# Data
PRICE_DATA_SOURCE=mock

# News Analysis
NEWS_MODEL_TYPE=finbert
NEWS_MAX_LENGTH=2000

# App
APP_ENV=development
LOG_LEVEL=debug
