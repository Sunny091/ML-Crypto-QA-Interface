# =============================================
# Crypto Price Prediction System - 環境配置
# LLM + MCP + Flask 整合架構
# =============================================
# 複製此文件為 .env 並填入實際值

# ===== Application =====
APP_ENV=development
LOG_LEVEL=debug

# ===== Flask API =====
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=true

# ===== LLM (Ollama) =====
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=60000
OLLAMA_API_KEY=

# ===== Data Source (DataOps) =====
PRICE_DATA_SOURCE=api

# ===== Model Configuration (MLOps) =====
PRICE_ONLY_MODEL_NAME=price_only_lgbm.pkl
PRICE_TEXT_MODEL_NAME=price_text_lgbm.pkl
TRANSFORMER_MODEL_NAME=transformer.pt

# ===== News Sentiment =====
NEWS_MODEL_TYPE=mock
NEWS_MAX_LENGTH=2000

# ===== MCP Server (Optional) =====
MCP_SERVER_NAME=crypto-predictor
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=4000
